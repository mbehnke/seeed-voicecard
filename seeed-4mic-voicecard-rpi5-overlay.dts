/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target = <&i2s>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target-path = "/";
		__overlay__ {
			ac108_mclk: codec-mclk {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <24000000>;
			};
		};
	};

	fragment@2 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			ac108_a: ac108@3b {
				compatible = "x-power,ac108_0";
				reg = <0x3b>;
				#sound-dai-cells = <0>;
				data-protocol = <0>;
			};
		};
	};

	fragment@3 {
		target-path = "/";
		__overlay__ {
			sound: sound {
				/*
				 * Clean up legacy properties/nodes from older seeed-voicecard
				 * overlays which may have been merged previously.
				 */
				compatible = "simple-audio-card";
				simple-audio-card,format = "i2s";
				simple-audio-card,name = "seeed-4mic";
				simple-audio-card,bitclock-master = <&cpu_dai>;
				simple-audio-card,frame-master = <&cpu_dai>;

				/delete-property/ seeed-voice-card,name;
				/delete-property/ seeed-voice-card,format;
				/delete-property/ seeed-voice-card,bitclock-master;
				/delete-property/ seeed-voice-card,frame-master;
				/delete-property/ seeed-voice-card,channels-capture-override;
				/delete-property/ seeed-voice-card,channels-playback-override;
				/delete-node/ seeed-voice-card,cpu;
				/delete-node/ seeed-voice-card,codec;

				cpu_dai: simple-audio-card,cpu {
					sound-dai = <&i2s>;
			};

			simple-audio-card,codec {
				sound-dai = <&ac108_a>;
				clocks = <&ac108_mclk>;
				clock-names = "mclk";
				};
			};
		};
	};
};
